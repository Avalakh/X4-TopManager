    <cue name="ThreatRangeWatch" instantiate="true" namespace="this">
      <conditions><event_cue_signalled /></conditions>
      <actions><set_value name="$Scene" exact="State.$Threat.$range_scene" /></actions>
      <cues>
        <cue name="TransportHit" instantiate="true">
          <conditions><event_object_attacked object="$Scene.$target" attacker="$Scene.$enemy" /></conditions>
          <actions>
            <set_value name="$Scene.$hits" operation="add" exact="1" />
            <do_if value="not $Scene.$first_hit?"><set_value name="$Scene.$first_hit" exact="player.age" /></do_if>
          </actions>
        </cue>
        <cue name="OwnedResponse" instantiate="true">
          <conditions><event_object_attacked object="$Scene.$enemy" /><check_value value="event.param.isplayerowned and event.param.isclass.ship and event.param != player.controlled and $Scene.$responses.count lt 16 and (not $Scene.$response_seen? or not $Scene.$response_seen.{event.param}? or @$Scene.$response_seen.{event.param}.$goal != @global.$TM_EmpireComponentRecords.$claim.{event.param}.$goal)" /></conditions>
          <actions>
            <set_value name="$Ship" exact="event.param" />
            <do_if value="not $Scene.$response_seen?"><set_value name="$Scene.$response_seen" exact="table[]" /></do_if>
            <set_value name="$Scene.$response_seen.{$Ship}" exact="table[$goal=@global.$TM_EmpireComponentRecords.$claim.{$Ship}.$goal]" />
            <set_value name="$Claim" exact="@global.$TM_EmpireComponentRecords.$claim.{$Ship}" />
            <run_actions ref="md.TM_Empire_Runtime.ReadOwnedOrderEvidence" result="$Evidence"><param name="Ship" value="$Ship" /><param name="Goal" value="@$Claim.$goal" /><param name="Manager" value="@md.TM_Empire_Runtime.Registry.$ManagerCue" /></run_actions>
            <run_actions ref="md.TM_Empire_Runtime.DescribeNativeMilitaryGoal" result="$Military"><param name="GoalCue" value="@$Claim.$goal" /></run_actions>
            <append_to_list name="$Scene.$responses" exact="table[$ship=$Ship, $observed=player.age, $manager_matches=(@$Claim.$manager == @md.TM_Empire_Runtime.Registry.$ManagerCue), $goal=@$Claim.$goal, $military=$Military, $confirmed=$Evidence.$confirmed, $complete=$Evidence.$complete, $reason=$Evidence.$reason, $order=@$Ship.order.id]" />
          </actions>
        </cue>
      </cues>
    </cue>
    <cue name="SurplusWatch" instantiate="true" namespace="this">
      <conditions><event_cue_signalled /></conditions>
      <actions><set_value name="$Buyer" exact="State.$Surplus.$buyer" /><set_value name="$Source" exact="State.$Surplus.$source" /></actions>
      <cues>
        <cue name="Sale">
          <conditions><event_trade_completed buyer="$Buyer" ware="ware.siliconwafers" /><check_value value="event.param.seller.isplayerowned and event.param.transferredamount gt 0 and (event.param.seller == $Source or event.param.seller.commander == $Source)" /></conditions>
          <actions><set_value name="State.$Surplus.$state" exact="'observed'" /><set_value name="State.$Surplus.$amount" exact="event.param.transferredamount" /><set_value name="State.$Surplus.$seller" exact="event.param.seller" /><set_value name="State.$Surplus.$observed" exact="player.age" /></actions>
        </cue>
      </cues>
    </cue>
  </cues>
</mdscript>








