<?xml version='1.0' encoding='utf-8'?>
<mdscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="TM_Empire_FactionSubgoal_Recon" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <cue name="Start" instantiate="true" namespace="this" version="3">
      <conditions>
        <event_cue_signalled />
        <check_value value="typeof event.param == datatype.table" />
      </conditions>
      <actions>
        <set_value name="$OwnerGoal" exact="event.param.$OwnerGoal" />
        <set_value name="$TM_ManagerCue" exact="@$OwnerGoal.$TM_ManagerCue" />
        <set_value name="$Descriptor" exact="event.param.$Descriptor" />
        <set_value name="$OwnerStandbyShipsTable" exact="@event.param.$OwnerStandbyShipsTable" />
        <set_value name="$DesiredEndTime" exact="event.param.$DesiredEndTime" />
        <set_value name="$Faction" exact="$OwnerGoal.$Faction" />
        <set_value name="$DesiredShipStrength" exact="event.param.$DesiredShipStrength" />
        <set_value name="$FindShipSpaces" exact="event.param.$FindShipSpaces" />
        <set_value name="$Target" exact="event.param.$Target" />
        <set_value name="$Home" exact="event.param.$Home" />
        <set_value name="$DebugChance" exact="@event.param.$DebugChance" />
        <set_value name="$DebugChance2" exact="@event.param.$DebugChance2" />
        <set_value name="$TargetZone" exact="if $Target.isclass.zone then $Target else null" />
        <set_value name="$TargetSector" exact="if $Target.isclass.sector then $Target else (if $TargetZone then $TargetZone.sector else null)" />
        <set_value name="$TargetCluster" exact="if $Target.isclass.cluster then $Target else (if $TargetSector then $TargetSector.cluster else null)" />
        <assert value="$TargetCluster" text="'Recon subgoal does not have a TargetCluster. Target: ' + $Target + ' [Owen]'" />
        <do_if value="$DebugChance or $DebugChance2 or player.debugfilteractive.economy_verbose">
          <include_actions ref="GenerateDebugTextWithCueID" />
          <debug_text filter="economy_verbose" text="'#FL#;%1;Started;%2;%3;%4;%5;%6;%7;%8'.[player.age, $DebugGoalText, $DebugText, null, null, $Target.knownname, $Faction.id, @$OwnerGoal.$EnemyFaction.id]" context="false" />
        </do_if>
        <do_else>
          <set_value name="$DebugText" exact="'(' + $Faction.id + ') Recon: ' + $Target + ' ' + $Target.knownname                    + (if not $TargetZone or $Target == $TargetZone then ''        else ' - Zone: ' + $TargetZone.knownname)                    + (if not $TargetSector or $Target == $TargetSector then ''    else ' - Sector: ' + $TargetSector.knownname)                    + (if not $TargetCluster or $Target == $TargetCluster then ''  else ' - Cluster: ' + $TargetCluster.knownname) + ' - ' + ' time ' + namespace.time" />
        </do_else>
        <debug_text text="'triggering ' + $DebugText" chance="$DebugChance" />
        <assert value="$FindShipSpaces.count" text="'No local areas defined to acquire ships to commandeer or order. Target: ' + $Target + ' ' + $Target.knownname + ' [Owen]'" />
        <create_group groupname="$Ships" />
        <create_list name="$RequestedShips" />
        <set_value name="$EvaluationResult" exact="'unknown'" />
        <set_value name="$EvaluationDelay" exact="1ms" />
        <set_value name="$InStandby" exact="false" />
        <set_value name="$AllowedShipRequests" exact="1" />
        <set_value name="$StrengthTable" exact="table[]" />
        <set_value name="$OverTime" exact="$DesiredEndTime + 10min" />
        <set_value name="$RegistryTable" exact="table[]" />
        <set_value name="$RegistryTable.$Cue" exact="this" />
        <set_value name="$RegistryTable.$StartTime" exact="player.age" />
        <set_value name="$RegistryTable.$EvaluationResult" exact="$EvaluationResult" />
        <set_value name="$RegistryTable.$DesiredShipStrength" exact="$DesiredShipStrength" />
        <signal_cue_instantly cue="$OwnerGoal" param="['add_subgoal', $RegistryTable]" />
      </actions>
      <cues>
        <cue name="Init" onfail="cancel">
          <conditions>
            <check_value value="not @$SetToShutdown" />
          </conditions>
          <actions>
            <debug_text text="$DebugText + 'Initialised'" chance="$DebugChance" />
            <set_value name="$RegistryTable.$GenerateReportCue" exact="Generate_Report" />
            <set_value name="$RegistryTable.$UpdateSubgoalCue" exact="Update_Sub_Goal" />
            <set_value name="$RegistryTable.$EvaluateShipStrengthCue" exact="Evaluate_Ship_Strength" />
            <set_value name="$RegistryTable.$EvaluateCue" exact="Force_Evaluation" />
            <include_actions ref="SetFindShipFocusSpace" />
          </actions>
        </cue>
        <cue name="Generate_Report" instantiate="true">
          <conditions>
            <event_cue_signalled />
          </conditions>
          <actions>
            <debug_text text="'SUBGOAL (' + $EvaluationResult + ') ' + $DebugText + 'Ships: ' + $Ships.count + ' Requested: ' + $RequestedShips.count + ' time ' + namespace.time" context="false" />
            <do_if value="$Ships.count">
              <debug_text text="'Active ships '" context="false" />
              <do_all exact="$Ships.count" counter="$i">
                <debug_text text="$Ships.{$i} + ' ' + $Ships.{$i}.knownname + ' ' + $Ships.{$i}.idcode" context="false" />
              </do_all>
            </do_if>
            <do_if value="$RequestedShips.count">
              <debug_text text="'Requested ships '" context="false" />
              <do_all exact="$RequestedShips.count" counter="$i">
                <debug_text text="$RequestedShips.{$i} + ' ' + $RequestedShips.{$i}.knownname + ' ' + $RequestedShips.{$i}.idcode" context="false" />
              </do_all>
            </do_if>
          </actions>
        </cue>
        <cue name="Update_Sub_Goal" instantiate="true">
          <conditions>
            <event_cue_signalled />
          </conditions>
          <actions>
            <debug_text text="$DebugText + 'Update request: ' + event.param.{1}" chance="$DebugChance" />
            <do_if value="event.param.{1} == 'cleanup'">
              <signal_cue_instantly cue="Cleanup" param="[false]" />
            </do_if>
            <do_elseif value="event.param.{1} == 'handoff'">
              <signal_cue_instantly cue="Cleanup" param="[true]" />
            </do_elseif>
            <do_elseif value="event.param.{1} == 'standby'">
              <set_value name="$InStandby" exact="true" />
            </do_elseif>
            <do_elseif value="event.param.{1} == 'reactivate'">
              <assert value="$InStandby" text="$DebugText + 'subgoal was not in standby when asked to reactivate [Owen]'" break="1" />
              <set_value name="$InStandby" exact="false" />
              <signal_cue_instantly cue="$OwnerGoal" param="['reactivate_subgoal', $RegistryTable]" />
            </do_elseif>
            <do_else>
              <assert value="event.param.{1}" text="$DebugText + 'Unknown update request [Owen]'" break="1" />
            </do_else>
          </actions>
        </cue>
        <cue name="Evaluate_Ship_Strength" instantiate="true">
          <conditions>
            <event_cue_signalled />
          </conditions>
          <actions>
            <clear_table table="$StrengthTable" />
            <run_actions ref="md.TM_Empire_FactionLogic.EvaluateForceStrengthLib" result="$EFS_Result">
              <param name="Ships" value="$Ships" />
              <param name="ResultTable" value="$StrengthTable" />
            </run_actions>
            <set_value name="$ForceStrength" exact="$EFS_Result" />
            <run_actions ref="md.TM_Empire_FactionLogic.EvaluateForceStrengthLib" result="$EFS_Result">
              <param name="Ships" value="$RequestedShips" />
              <param name="ResultTable" value="$StrengthTable" />
            </run_actions>
            <set_value name="$ForceStrength" operation="add" exact="$EFS_Result" />
            <set_value name="$RegistryTable.$ShipStrength" exact="$ForceStrength" />
          </actions>
        </cue>
        <cue name="Force_Evaluation" instantiate="true">
          <conditions>
            <check_any>
              <event_cue_signalled />
              <event_object_destroyed object="$Target" check="false" comment="check-false to prevent errors. patch code will handle it" />
            </check_any>
          </conditions>
          <actions>
            <set_value name="$EvaluationDelay" exact="0s" />
            <reset_cue cue="Evaluate" />
          </actions>
        </cue>
        <library name="Validate_Requested_Ships">
          <actions>
            <do_all exact="$RequestedShips.count" counter="$i" reverse="true">
              <do_if value="not $RequestedShips.{$i}.isrealclass.ship">
                <assert value="false" text="'Requested ship is no longer valid. ID: ' + $RequestedShips.{$i} + ' - It should have been removed from this list by other means. [Owen]'" break="1" />
                <signal_cue_instantly cue="Remove_Requested_Ship" param="$RequestedShips.{$i}" />
              </do_if>
            </do_all>
          </actions>
        </library>
        <library name="SetFindShipFocusSpace">
          <actions>
            <set_value name="$FindShipFocusSpace" exact="null" />
            <do_all exact="$FindShipSpaces.count" counter="$i">
              <do_if value="$Home == $FindShipSpaces.{$i} or $Home.hascontext.{$FindShipSpaces.{$i}}">
                <set_value name="$FindShipFocusSpace" exact="$FindShipSpaces.{$i}" />
                <break />
              </do_if>
            </do_all>
          </actions>
        </library>
        <cue name="Evaluate">
          <delay exact="$EvaluationDelay" />
          <actions>
            <set_value name="$OldResult" exact="$EvaluationResult" />
            <set_value name="$EvaluationResult" exact="'unknown'" />
            <do_if value="$Target.exists and $OldResult != 'failed'">
              <include_actions ref="Validate_Requested_Ships" />
              <set_value name="$ForceStrength" exact="0" />
              <signal_cue_instantly cue="Evaluate_Ship_Strength" comment="returns $ForceStrength" />
              <debug_text text="$DebugText + ' wants strength of ' + $DesiredShipStrength + ' currently ' + $EFS_Result" context="false" chance="$DebugChance2" />
              <do_if value="not $InStandby and $ForceStrength lt $DesiredShipStrength">
                <do_if value="$FindShipSpaces.count">
                  <do_all exact="2" counter="$Pass">
                    <do_all exact="$FindShipSpaces.count" counter="$i">
                      <do_if value="not $FindShipFocusSpace">
                        <do_if value="$i == 1">
                          <shuffle_list list="$FindShipSpaces" />
                        </do_if>
                        <set_value name="this.$FindSpace" exact="$FindShipSpaces.{$i}" />
                      </do_if>
                      <do_elseif value="$i == 1">
                        <set_value name="this.$FindSpace" exact="$FindShipFocusSpace" />
                      </do_elseif>
                      <do_else>
                        <do_if value="$i == 2">
                          <shuffle_list list="$FindShipSpaces" />
                        </do_if>
                        <do_if value="$FindShipSpaces.{$i} == $FindShipFocusSpace">
                          <set_value name="this.$FindSpace" exact="$FindShipSpaces.{1}" />
                        </do_if>
                        <do_else>
                          <set_value name="this.$FindSpace" exact="$FindShipSpaces.{$i}" />
                        </do_else>
                      </do_else>
                      <do_if value="$Pass == 1">
                        <find_ship_by_true_owner name="$PotentialShips" faction="$Faction" multiple="true" space="this.$FindSpace" known="true" shiptype="shiptype.scout">
                          </find_ship_by_true_owner>
                      </do_if>
                      <do_else>
                        <find_ship_by_true_owner name="$PotentialShips" faction="$Faction" primarypurpose="purpose.fight" multiple="true" space="this.$FindSpace" class="[class.ship_s, class.ship_m]" known="true" />
                      </do_else>
                      <set_value name="$NewShipCount" exact="0" />
                      <shuffle_list list="$PotentialShips" />
                      <do_if value="@$TM_WaitReason == 'military_ship_sample_incomplete'">
                        <remove_value name="$TM_WaitReason" />
                      </do_if>
                      <do_if value="$PotentialShips.count gt 32">
                        <set_value name="$TM_WaitReason" exact="'military_ship_sample_incomplete'" />
                      </do_if>
                      <do_all exact="[32, $PotentialShips.count].min" counter="$k">
                        <set_value name="$Ship" exact="$PotentialShips.{$k}" />
                        <do_if value="$Ships.indexof.{$Ship}">
                          <continue />
                        </do_if>
                        <run_actions ref="md.TM_Empire_Runtime.CanUseOwnedShip" result="$TM_ShipReason">
                          <param name="Ship" value="$Ship" />
                          <param name="GoalCue" value="namespace" />
                          <param name="ManagerCue" value="@$TM_ManagerCue" />
                        </run_actions>
                        <do_if value="$TM_ShipReason != 'available'">
                          <continue />
                        </do_if>
                        <run_actions ref="md.TM_Empire_Runtime.ClaimOwnedShip" result="$TM_ShipReason">
                          <param name="Ship" value="$Ship" />
                          <param name="GoalCue" value="namespace" />
                          <param name="ManagerCue" value="@$TM_ManagerCue" />
                        </run_actions>
                        <do_if value="$TM_ShipReason == 'available'">
                          <add_to_group groupname="$Ships" object="$Ship" />
                          <set_value name="$NewShipCount" operation="add" />
                          <run_actions ref="md.TM_Empire_FactionLogic.EvaluateForceStrengthLib" result="$EFS_Result">
                            <param name="Ships" value="$Ship" />
                            <param name="ResultTable" value="$StrengthTable" />
                          </run_actions>
                          <set_value name="$ForceStrength" operation="add" exact="$EFS_Result" />
                          <set_value name="$RegistryTable.$ShipStrength" exact="$EFS_Result" operation="add" />
                          <debug_text text="$DebugText + ' commandeered ' + $Ship.knownname + ' ' + $Ship + ' with strength ' + $EFS_Result + ' force strength is now: ' + $ForceStrength + ' - desired: '+ $DesiredShipStrength" context="false" chance="$DebugChance" />
                          <signal_cue_instantly cue="Set_Ship_Order" param="$Ship" />
                          <do_if value="$ForceStrength ge $DesiredShipStrength">
                            <break />
                          </do_if>
                        </do_if>
                        <do_else>
                          <set_value name="$TM_WaitReason" exact="$TM_ShipReason" />
                        </do_else>
                      </do_all>
                      <debug_text text="$DebugText + 'found ' + $NewShipCount + ' ships in space: ' + this.$FindSpace.knownname" context="false" chance="if $NewShipCount then $DebugChance2 else 0" />
                      <do_if value="$ForceStrength ge $DesiredShipStrength">
                        <break />
                      </do_if>
                    </do_all>
                  </do_all>
                </do_if>
                <debug_text text="$DebugText + $Ships.count + ' ships with force strength of ' + $ForceStrength + ' out of wanted strength ' + $DesiredShipStrength" context="false" chance="$DebugChance2" />
                <do_if value="($ForceStrength lt $DesiredShipStrength and $AllowedShipRequests gt $RequestedShips.count) and not @md.TM_Empire_Purchase.Request.$Pending and player.age ge @md.TM_Empire_Purchase.Request.$NextAttempt and (@md.TM_Empire_Purchase.Request.$LastResult.$state != 'delivered' or @md.TM_Empire_Purchase.Request.$LastResult.$accepted)">
                  <signal_cue_instantly cue="md.TM_Empire_FactionLogic.Get_Scout_Jobs" param="[namespace, $DesiredShipStrength - $ForceStrength, $Faction, true]" />
                  <debug_text text="$DebugText + $Suitable_Jobs.count + ' suitable jobs found'" context="false" chance="$DebugChance" />
                  <do_all exact="$Suitable_Jobs.count" counter="$i">
                    <set_value name="$JobMainZone" exact="$Home" />
                    <debug_text text="$DebugText + 'Requested job ship to be created. Job ' + $Suitable_Jobs.{$i} + '; Job zone: ' + $JobMainZone + ' ' + $JobMainZone.knownname" context="false" chance="$DebugChance" />
                    <signal_cue_instantly cue="Request_Job_Ship" param="[$Suitable_Jobs.{$i}, $JobMainZone]" />
                    <do_if value="@md.TM_Empire_Purchase.Request.$Pending">
                      <break />
                    </do_if>
                  </do_all>
                  <debug_text text="$DebugText + $RequestedShips.count + ' ships are currently requested'" context="false" chance="$DebugChance2" />
                </do_if>
              </do_if>
              <set_value name="$ArrivedStrength" exact="0" />
              <set_value name="$DistantStrength" exact="0" />
              <set_value name="$RequestedShipStrength" exact="0" />
              <create_list name="$ArrivedShips" />
              <do_all exact="$Ships.count" counter="$i">
                <set_value name="$Ship" exact="$Ships.{$i}" />
                <do_if value="$Ship.hascontext.{$Target}">
                  <set_value name="$ArrivedStrength" exact="$StrengthTable.{$Ship}" operation="add" />
                  <append_to_list name="$ArrivedShips" exact="$Ship" />
                </do_if>
                <do_else>
                  <set_value name="$DistantStrength" exact="$StrengthTable.{$Ship}" operation="add" />
                </do_else>
              </do_all>
              <do_all exact="$RequestedShips.count" counter="$i">
                <set_value name="$RequestedShipStrength" exact="$StrengthTable.{$RequestedShips.{$i}}" operation="add" />
              </do_all>
              <do_if value="$ArrivedStrength ge $DesiredShipStrength">
                <set_value name="$EvaluationResult" exact="'performing'" />
              </do_if>
              <do_elseif value="not $DesiredEndTime">
                <set_value name="$EvaluationResult" exact="'preparing'" />
              </do_elseif>
              <do_elseif value="not $InStandby and player.age gt $DesiredEndTime">
                <do_if value="not $OverTime or player.age gt $OverTime">
                  <set_value name="$EvaluationResult" exact="'failed'" />
                </do_if>
                <do_elseif value="$ArrivedStrength + $DistantStrength ge $DesiredShipStrength">
                  <set_value name="$EvaluationResult" exact="'overtime'" />
                </do_elseif>
                <do_else>
                  <set_value name="$EvaluationResult" exact="'failed'" />
                </do_else>
              </do_elseif>
              <do_else>
                <set_value name="$EvaluationResult" exact="'preparing'" />
              </do_else>
            </do_if>
            <do_else>
              <set_value name="$EvaluationResult" exact="'failed'" />
            </do_else>
            <debug_text text="$DebugText + 'Evaluation result changed from ' + $OldResult + ' to ' + $EvaluationResult" context="false" chance="if $EvaluationResult == $OldResult then 0 else $DebugChance" />
            <do_if value="$RequestedShips.count and $EvaluationResult == 'failed'">
              <debug_text text="'Subgoal has failed. Releasing requested ships. Active ships will be handled by the goal.'" chance="$DebugChance" />
              <do_all exact="$RequestedShips.count" counter="$i" reverse="true">
                <signal_cue_instantly cue="Remove_Requested_Ship" param="$RequestedShips.{$i}" />
              </do_all>
            </do_if>
            <set_value name="$RegistryTable.$EvaluationResult" exact="$EvaluationResult" />
            <assert value="$EvaluationResult != 'unknown'" text="'Subgoal is in an invalid state [Owen]'" />
            <set_value name="$EvaluationDelay" min="10s" max="20s" />
            <reset_cue cue="Evaluate" />
          </actions>
        </cue>
        <cue name="Request_Job_Ship" instantiate="true" version="1">
          <conditions>
            <event_cue_signalled />
          </conditions>
          <actions>
            <set_value name="this.$Option" exact="event.param.{1}" />
            <do_if value="typeof this.$Option == datatype.table">
              <run_actions ref="md.TM_Empire_Purchase.PreparePurchase" result="this.$PurchaseState">
                <param name="ManagerCue" value="$TM_ManagerCue" />
                <param name="GoalCue" value="namespace" />
                <param name="Shipyard" value="this.$Option.$shipyard" />
                <param name="Macro" value="this.$Option.$macro" />
                <param name="Budget" value="player.money" />
              </run_actions>
              <do_if value="this.$PurchaseState == 'quote_requested'">
                <set_value name="this.$PurchaseKey" exact="md.TM_Empire_Purchase.Request.$Pending.$key" />
              </do_if>
              <do_else>
                <set_value name="$TM_WaitReason" exact="this.$PurchaseState" />
                <run_actions ref="md.TM_Empire_Runtime.RevokeGoalApprovals">
                  <param name="CancelledCue" value="this" />
                </run_actions>
                <cancel_cue cue="this" />
              </do_else>
            </do_if>
            <do_else>
              <set_value name="$TM_WaitReason" exact="'invalid_purchase_option'" />
              <run_actions ref="md.TM_Empire_Runtime.RevokeGoalApprovals">
                <param name="CancelledCue" value="this" />
              </run_actions>
              <cancel_cue cue="this" />
            </do_else>
          </actions>
          <cues>
            <cue name="PurchasedShipObserved" checkinterval="15s">
              <conditions>
                <check_value value="parent.$PurchaseKey?" />
              </conditions>
              <delay exact="15s" />
              <actions>
                <do_if value="@md.TM_Empire_Purchase.Request.$Pending.$key == parent.$PurchaseKey and (md.TM_Empire_Purchase.Tracked.$Build? or @md.TM_Empire_Purchase.Request.$Pending.$state == 'ready')">
                  <run_actions ref="md.TM_Empire_Purchase.CompletePurchase" result="this.$Progress" />
                </do_if>
                <do_if value="@md.TM_Empire_Purchase.Request.$LastResult.$key == parent.$PurchaseKey">
                  <do_if value="md.TM_Empire_Purchase.Request.$LastResult.$state == 'delivered'">
                    <set_value name="this.$Ship" exact="md.TM_Empire_Purchase.Request.$LastResult.$ship" />
                    <do_if value="not $Ships.indexof.{this.$Ship}">
                      <add_to_group groupname="$Ships" object="this.$Ship" />
                      <run_actions ref="md.TM_Empire_FactionLogic.EvaluateForceStrengthLib" result="$EFS_Result">
                        <param name="Ships" value="this.$Ship" />
                        <param name="ResultTable" value="$StrengthTable" />
                      </run_actions>
                      <set_value name="$ForceStrength" operation="add" exact="$EFS_Result" />
                      <set_value name="$RegistryTable.$ShipStrength" operation="add" exact="$EFS_Result" />
                      <signal_cue_instantly cue="Set_Ship_Order" param="this.$Ship" />
                    </do_if>
                    <run_actions ref="md.TM_Empire_Purchase.AcknowledgeDelivery" result="$TM_DeliveryReceipt">
                      <param name="Key" value="parent.$PurchaseKey" />
                      <param name="GoalCue" value="namespace" />
                      <param name="Ship" value="this.$Ship" />
                    </run_actions>
                  </do_if>
                  <do_else>
                    <set_value name="$TM_WaitReason" exact="md.TM_Empire_Purchase.Request.$LastResult.$reason" />
                  </do_else>
                  <run_actions ref="md.TM_Empire_Runtime.RevokeGoalApprovals">
                    <param name="CancelledCue" value="parent" />
                  </run_actions>
                  <cancel_cue cue="parent" />
                </do_if>
                <do_else>
                  <set_value name="$TM_WaitReason" exact="'purchase_pending_native_receipt'" />
                  <reset_cue cue="this" />
                </do_else>
              </actions>
            </cue>
          </cues>
        </cue>
        <cue name="Remove_Requested_Ship" instantiate="true">
          <conditions>
            <event_cue_signalled />
          </conditions>
          <actions>
            <do_if value="event.param.isrealclass.ship">
              <remove_job_ship_request ship="event.param" />
            </do_if>
            <remove_from_list name="$RequestedShips" exact="event.param" />
          </actions>
        </cue>
        <cue name="Ship_Changed_Owner" instantiate="true">
          <conditions>
            <check_any>
              <event_object_changed_owner group="$Ships" />
            </check_any>
          </conditions>
          <actions>
            <run_actions ref="md.TM_Empire_Runtime.ReleaseOwnedClaim" result="$TM_ShipReason">
              <param name="Ship" value="event.object" />
              <param name="GoalCue" value="namespace" />
            </run_actions>
            <remove_from_group group="$Ships" object="event.object" />
          </actions>
        </cue>
        <cue name="ReconFleetLost">
          <conditions>
            <check_any>
              <event_object_destroyed group="$Ships" />
              <event_cue_completed cue="Ship_Changed_Owner" />
            </check_any>
          </conditions>
          <actions>
            <do_if value="(event.name=='event_object_destroyed' and $Ships.count == 1) or (event.name=='event_cue_completed' and $Ships.count == 0)">
              <debug_text text="'ReconFleetDestroyed (targetspace was' + $Target+') force-strength was' + $ForceStrength" chance="$DebugChance" />
            </do_if>
          </actions>
        </cue>
        <cue name="Set_Ship_Order" instantiate="true" version="4">
          <conditions>
            <event_cue_signalled />
            <check_value value="event.param.exists" />
          </conditions>
          <actions>
            <set_value name="this.$OrderShip" exact="event.param" />
          </actions>
          <cues>
            <cue name="SetShipOrderInit">
              <actions>
                <debug_text text="$DebugText + 'SetOrder ' + parent.$OrderShip + '(' + parent.$OrderShip.knownname + ') Recon TargetSpace=' + $Target + ' (isnormalzone=' + $Target.isnormalzone + ' istempzone=' + $Target.istempzone + ')'" context="false" chance="$DebugChance" />
                <run_actions ref="md.TM_Empire_Runtime.CanUseOwnedShip" result="$TM_ShipReason">
                  <param name="Ship" value="parent.$OrderShip" />
                  <param name="GoalCue" value="namespace" />
                  <param name="ManagerCue" value="@$TM_ManagerCue" />
                </run_actions>
                <do_if value="$TM_ShipReason == 'available'">
                  <run_actions ref="md.TM_Empire_Runtime.ClaimOwnedShip" result="$TM_ShipReason">
                    <param name="Ship" value="parent.$OrderShip" />
                    <param name="GoalCue" value="namespace" />
                    <param name="ManagerCue" value="@$TM_ManagerCue" />
                  </run_actions>
                  <do_if value="$TM_ShipReason == 'available'">
                    <set_value name="global.$TM_EmpireComponentRecords.$claim.{parent.$OrderShip}.$issuing" exact="true" />
                    <create_order id="'Recon'" object="parent.$OrderShip" name="parent.$reconorder">
                      <param name="targetspace" value="$Target" />
                      <param name="timeout" value="[10min,15min,20min].random" />
                      <param name="deploysatellites" value="true" />
                    </create_order>
                    <run_actions ref="md.TM_Empire_Runtime.RecordOwnedOrder" result="$TM_OrderReceipt">
                      <param name="Ship" value="parent.$OrderShip" />
                      <param name="GoalCue" value="namespace" />
                      <param name="Order" value="parent.$reconorder" />
                    </run_actions>
                  </do_if>
                  <do_else>
                    <set_value name="$TM_WaitReason" exact="$TM_ShipReason" />
                    <set_value name="parent.$reconorder" exact="null" />
                  </do_else>
                </do_if>
                <do_else>
                  <set_value name="$TM_WaitReason" exact="$TM_ShipReason" />
                  <set_value name="parent.$reconorder" exact="null" />
                </do_else>
                <do_if value="parent.$OrderShip.hascontext.{$Target}">
                  <signal_cue cue="ReconStarted" />
                </do_if>
              </actions>
            </cue>
            <cue name="DEBUG_DestroyReconFleet">
              <conditions>
                <event_cue_signalled />
              </conditions>
              <actions>
                <do_all exact="$Ships.count" counter="$i" reverse="true">
                  <run_actions ref="md.TM_Empire_Runtime.StopAndReleaseOwnedShip" result="$TM_ReleaseReason">
                    <param name="Ship" value="$Ships.{$i}" />
                    <param name="ManagerCue" value="$TM_ManagerCue" />
                    <param name="GoalCue" value="namespace" />
                  </run_actions>
                </do_all>
              </actions>
            </cue>
            <cue name="ReconShipDestroyed">
              <conditions>
                <event_object_destroyed object="parent.$OrderShip" />
              </conditions>
              <actions>
                <debug_text text="'Ship destroyed ' + parent.$OrderShip" chance="$DebugChance" />
                <run_actions ref="md.TM_Empire_Runtime.RevokeGoalApprovals">
                  <param name="CancelledCue" value="Set_Ship_Order" />
                </run_actions>
                <cancel_cue cue="Set_Ship_Order" />
              </actions>
            </cue>
            <cue name="ReconStarted" comment="Triggers when parent.$OrderShip running the 'Recon'-order arrives in the space to recon">
              <conditions>
                <check_any>
                  <event_object_changed_sector object="parent.$OrderShip" sector="$TargetSector" />
                  <event_cue_signalled />
                </check_any>
              </conditions>
              <actions>
                <debug_text text="'Started recon at t=' + player.age + ' ship=' + parent.$OrderShip + ' ($Ships=' + $Ships + ' force-strenght=' + $ForceStrength+')'" chance="$DebugChance" />
                <run_actions ref="md.TM_Empire_FactionLogic.Get_Faction_Situation_By_Sector" result="this.$NotificationSituation">
                  <param name="Sector" value="$TargetSector" />
                  <param name="Faction" value="$Faction" />
                </run_actions>
                <do_if value="this.$NotificationSituation">
                  <do_if value="this.$NotificationSituation == 'faction_is_war_host'">
                    <set_value name="this.$NotificationHeadline" exact="{1015,301}" comment="War update" />
                  </do_if>
                  <do_elseif value="this.$NotificationSituation == 'faction_is_war_enemy'">
                    <set_value name="this.$NotificationHeadline" exact="{1015,301}" comment="War update" />
                  </do_elseif>
                  <do_elseif value="this.$NotificationSituation == 'enemy_to_local_friend'">
                    <set_value name="this.$NotificationHeadline" exact="{1015,309}" comment="Emergency update" />
                  </do_elseif>
                  <do_elseif value="this.$NotificationSituation == 'neutral_to_local_friend'">
                    
                  </do_elseif>
                  <do_if value="@this.$NotificationHeadline">
                    <substitute_text text="$reason" source="{30004,8001}" comment="Increased $FACTION$ reconnaissance in $DESTINATION$">
                      <replace string="'$FACTION$'" with="$Faction.name" />
                      <replace string="'$DESTINATION$'" with="$TargetSector.knownname" />
                    </substitute_text>
                    <do_if value="md.$TM_Empire_DebuggingNotifications">
                      <set_value name="$reason" exact="$reason + '\n' + $DebugText + ' prevstate=' + $OldResult + ' state=' + $EvaluationResult + 'faction=' + $Faction" />
                    </do_if>
                    <signal_cue_instantly cue="md.GenericMissions.GenericNewsLogbookEntry" param="['', this.$NotificationHeadline, $reason]" />
                    <set_value name="namespace.static.$subgoal_lastnotification" exact="player.age" />
                  </do_if>
                </do_if>
              </actions>
              <cues>
                <cue name="ReconArrivedAtTarget" checkinterval="10s" comment="Triggers when near $Target">
                  <conditions>
                    <check_value value="(Set_Ship_Order.$OrderShip.sector == $Target.sector) and (Set_Ship_Order.$OrderShip.distanceto.{$Target} lt 30km)" />
                  </conditions>
                  <actions>
                    <debug_text text="'Arrived at target at t=' + player.age + ' ship=' + Set_Ship_Order.$OrderShip" chance="$DebugChance" />
                  </actions>
                </cue>
              </cues>
            </cue>
            <cue name="ReconOrderAborted">
              <conditions>
                <event_object_order_cancelled object="parent.$OrderShip" order="parent.$reconorder" />
                <check_value value="not event.param.exists" comment="only when recon-order was permanently removed" />
              </conditions>
              <actions>
                <run_actions ref="md.TM_Empire_Runtime.ReleaseOwnedClaim" result="$TM_ShipReason">
                  <param name="Ship" value="parent.$OrderShip" />
                  <param name="GoalCue" value="namespace" />
                </run_actions>
                <remove_from_group group="$Ships" object="parent.$OrderShip" />
                <debug_text text="'Ship aborted recon ' + parent.$OrderShip + ' new-order=' + event.object.order.id" chance="$DebugChance" />
              </actions>
            </cue>
            <cue name="ReconFinished">
              <conditions>
                <event_object_signalled object="parent.$OrderShip" comment="triggered by order.move.recon" />
                <check_value value="@event.param.{2} == 'recon update'" />
              </conditions>
              <actions>
                <set_value name="$EventParams" exact="event.param" />
                <do_if value="$Target == $EventParams.{4} or $Target.hascontext.{$EventParams.{4}}">
                  <debug_text text="'Ship=' + parent.$OrderShip + ' (' + parent.$OrderShip.knownname + ') finished its recon-task ($Ships=' + $Ships +')'" chance="$DebugChance" />
                  <debug_text text="'event=`' + $EventParams.{2} + '` - faction=`' + $EventParams.{1} + '` enemyfaction=`' + $EventParams.{3} + '` recon-targetspace=' + $Target + '(' + $Target.knownname + ') targetsector=' + $EventParams.{4} + '(' + $EventParams.{4}.knownname + ') recon(timestamp ' + $EventParams.{5}.{2} + ', threat-level=' + $EventParams.{5}.{1} + ') now=' + player.age" chance="$DebugChance" />
                </do_if>
                <do_else>
                  <debug_text text="'Ship=' + parent.$OrderShip + ' (' + parent.$OrderShip.knownname + ') finished unknown recon-task ($Ships=' + $Ships +')'" chance="$DebugChance" />
                </do_else>
              </actions>
            </cue>
          </cues>
        </cue>
        <cue name="Cleanup">
          <conditions>
            <check_any>
              <event_cue_cancelled cue="$OwnerGoal" />
              <event_cue_signalled />
              <event_object_destroyed object="$Home" />
            </check_any>
          </conditions>
          <actions>
            <do_if value="event.name == 'event_cue_signalled' and @event.param.{1} and $OwnerStandbyShipsTable and $OwnerGoal.exists">
              <set_value name="this.$ResultFeedbackList" exact="[false]" />
              <do_all exact="$Ships.count" counter="$i">
                <signal_cue_instantly cue="$OwnerGoal" param="['add_standby_ship', $Ships.{$i}, this.$ResultFeedbackList]" />
                <do_if value="this.$ResultFeedbackList.{1}">
                  <set_value name="this.$ResultFeedbackList.{1}" exact="false" />
                </do_if>
                <do_else>
                  <assert value="this.$ResultFeedbackList.{1}" text="'Attempted to add ship as a faction goal standby ship but it was rejected [Owen]'" break="1" />
                  <run_actions ref="md.TM_Empire_Runtime.ReleaseOwnedClaim" result="$TM_ShipReason">
                    <param name="Ship" value="$Ships.{$i}" />
                    <param name="GoalCue" value="namespace" />
                  </run_actions>
                </do_else>
              </do_all>
            </do_if>
            <do_else>
              <do_all exact="$Ships.count" counter="$i">
                <debug_text text="$DebugText + '%1(%2) resuming prior orders.'.[$Ships.{$i}, $Ships.{$i}.knownname]" context="false" chance="$DebugChance" />
                <run_actions ref="md.TM_Empire_Runtime.ReleaseOwnedClaim" result="$TM_ShipReason">
                  <param name="Ship" value="$Ships.{$i}" />
                  <param name="GoalCue" value="namespace" />
                </run_actions>
              </do_all>
            </do_else>
            <do_all exact="$RequestedShips.count" counter="$i">
              <debug_text text="$DebugText + 'Removing requested ship ' + $RequestedShips.{$i} + ' ' + $RequestedShips.{$i}.knownname" context="false" chance="$DebugChance" />
              <do_if value="$RequestedShips.{$i}.exists">
                <set_requested_job_ship_timeout ship="$RequestedShips.{$i}" timeout="player.age" />
              </do_if>
              <do_else>
                <remove_job_ship_request ship="$RequestedShips.{$i}" />
              </do_else>
            </do_all>
            <do_if value="player.debugfilteractive.economy_verbose">
              <include_actions ref="GenerateDebugTextWithCueID" />
              <debug_text filter="economy_verbose" text="'#FL#;%1;Cleanup;%2;%3;%4;%5;%6;%7;%8'.[player.age, $DebugGoalText, $DebugText, null, null, @$Target.knownname, $Faction.id, @$OwnerGoal.$EnemyFaction.id]" context="false" />
            </do_if>
            <do_if value="event.name != 'event_cue_cancelled'">
              <signal_cue_instantly cue="$OwnerGoal" param="['remove_subgoal', $RegistryTable]" />
            </do_if>
            <run_actions ref="md.TM_Empire_Runtime.RevokeGoalApprovals">
              <param name="CancelledCue" value="Start" />
            </run_actions>
            <cancel_cue cue="Start" />
          </actions>
        </cue>
      </cues>
    </cue>
    <library name="GenerateDebugTextWithCueID">
      <actions>
        <set_value name="$CueInstanceString" exact="'' + [namespace]" />
        <substitute_text source="$CueInstanceString" text="$DebugID">
          <replace string="'md.'" with="''" />
          <replace string="'.Start'" with="''" />
          <replace string="'['" with="''" />
          <replace string="']'" with="''" />
        </substitute_text>
        <do_if value="$Target.exists">
          <do_if value="$Target.sector">
            <set_value name="$TargetText" exact="$Target + ' ' + $Target.knownname + ' (' + $Target.sector.knownname + ')'" />
          </do_if>
          <do_else>
            <set_value name="$TargetText" exact="$Target + ' ' + $Target.knownname" />
          </do_else>
        </do_if>
        <do_else>
          <set_value name="$TargetText" exact="'INVALID'" />
        </do_else>
        <set_value name="$DebugText" exact="'(' + $Faction.id + ') ' + $DebugID + ' in: ' + $TargetText" />
        <remove_value name="$DebugID" />
        <remove_value name="$TargetText" />
        <set_value name="$CueInstanceString" exact="'' + [$OwnerGoal]" />
        <substitute_text source="$CueInstanceString" text="$DebugGoalText">
          <replace string="'md.'" with="''" />
          <replace string="'.Start'" with="''" />
          <replace string="'['" with="''" />
          <replace string="']'" with="''" />
        </substitute_text>
        <remove_value name="$CueInstanceString" />
      </actions>
    </library>
  </cues>
</mdscript>